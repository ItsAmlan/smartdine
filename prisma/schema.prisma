generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(255)
  logo             String?  @db.VarChar(500)
  tagline          String?  @db.VarChar(500)
  acceptingOrders  Boolean  @default(true)
  createdAt        DateTime @default(now())
  tables           Table[]
  staff            StaffUser[]
}

model Table {
  id           Int            @id @default(autoincrement())
  tableNumber  String         @unique @db.VarChar(50)
  qrCode       String?        @db.VarChar(500)
  active       Boolean        @default(true)
  restaurantId Int
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]
  stewardCalls StewardCall[]

  @@index([restaurantId])
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  dishes      Dish[]
}

model Dish {
  id          Int         @id @default(autoincrement())
  categoryId  Int
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String      @db.VarChar(200)
  description String?     @db.Text
  price       Decimal     @db.Decimal(10, 2)
  image       String?     @db.VarChar(500)
  available   Boolean     @default(true)
  isVeg       Boolean     @default(true)
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]

  @@index([categoryId])
  @@index([available])
}

model Customer {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(200)
  email            String   @db.VarChar(255)
  phone            String   @db.VarChar(20)
  recognitionToken String?  @unique @db.VarChar(64)
  createdAt        DateTime @default(now())
  orders           Order[]

  @@unique([email])
  @@index([phone])
}

model Order {
  id               Int         @id @default(autoincrement())
  orderNumber      String      @unique @db.VarChar(20)
  accessToken      String      @unique @db.VarChar(64)
  customerId       Int
  customer         Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tableId          Int
  table            Table       @relation(fields: [tableId], references: [id], onDelete: Cascade)
  status           String      @default("PENDING") @db.VarChar(30)
  totalAmount      Decimal     @db.Decimal(10, 2)
  estimatedMinutes Int?
  createdAt        DateTime    @default(now())
  acceptedAt       DateTime?
  completedAt      DateTime?
  deliveredAt      DateTime?
  items            OrderItem[]
  payment          Payment?

  @@index([status])
  @@index([tableId])
  @@index([customerId])
  @@index([createdAt])
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dishId      Int
  dish        Dish    @relation(fields: [dishId], references: [id], onDelete: Cascade)
  quantity    Int
  forTakeaway Boolean @default(false)
  unitPrice   Decimal @db.Decimal(10, 2)
  subtotal    Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([dishId])
}

model Payment {
  id                 Int      @id @default(autoincrement())
  orderId            Int      @unique
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  razorpayOrderId    String   @unique @db.VarChar(100)
  razorpayPaymentId  String?  @db.VarChar(100)
  razorpaySignature  String?  @db.VarChar(500)
  amount             Decimal  @db.Decimal(10, 2)
  status             String   @default("PENDING") @db.VarChar(30)
  createdAt          DateTime @default(now())

  @@index([status])
}

model StewardCall {
  id             Int       @id @default(autoincrement())
  tableId        Int
  table          Table     @relation(fields: [tableId], references: [id], onDelete: Cascade)
  status         String    @default("PENDING") @db.VarChar(30)
  message        String?   @db.VarChar(500)
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?

  @@index([status])
  @@index([tableId])
}

model StaffUser {
  id             Int       @id @default(autoincrement())
  name           String    @db.VarChar(200)
  role           String    @db.VarChar(30)
  passwordHash   String    @db.VarChar(255)
  active         Boolean   @default(true)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  restaurantId   Int
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())

  @@unique([name, role])
  @@index([role])
}

