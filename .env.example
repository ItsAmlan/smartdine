# MySQL connection string used by Prisma
DATABASE_URL="mysql://user:password@localhost:3306/smartdine"

# Secret used to sign staff session cookies (admin/kitchen/steward login).
# Generate one with: openssl rand -hex 32
SESSION_SECRET=""

# Razorpay payment gateway credentials (server-side)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Razorpay key id exposed to the browser checkout widget (same value as RAZORPAY_KEY_ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Public base URL of the app, used to build the QR code links printed for tables
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: pin the initial staff passwords `npx prisma db seed` creates.
# Leave unset and a strong random password is generated and printed once
# to the console for each account on first seed. Only used the first time
# each account is created; has no effect on existing accounts.
# SEED_ADMIN_PASSWORD=""
# SEED_KITCHEN_PASSWORD=""
# SEED_STEWARD_PASSWORD=""
